# ─── Google Sheets API ───────────────────────────────────────────────────────
# Create a service account at https://console.cloud.google.com
# Enable the Google Sheets API, create a service account key (JSON),
# then share your Google Sheet with the service account email.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# 1. Go to https://developers.facebook.com and create an app
# 2. Add the WhatsApp product
# 3. Get your Phone Number ID and a temporary/permanent access token

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# ─── App Config ──────────────────────────────────────────────────────────────
# Delay between messages in milliseconds (avoid rate limits)
WHATSAPP_SEND_DELAY_MS=1000
ANTHROPIC_API_KEY=sk-ant-...
