# ─── Google Sheets API ───────────────────────────────────────────────────────
# Create a service account at https://console.cloud.google.com
# Enable the Google Sheets API, create a service account key (JSON),
# then share your Google Sheet with the service account email.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ─── WhatsApp Web Service ────────────────────────────────────────────────────
# Vercel cannot run the persistent WhatsApp Web browser session directly.
# Deploy ./whatsapp-service on Render/Railway/VPS, then paste its public URL here.

WHATSAPP_SERVICE_URL=https://your-whatsapp-service.example.com

# ─── LinkedIn OAuth ──────────────────────────────────────────────────────────
# Create an app at https://www.linkedin.com/developers/apps
# Add this redirect URL in LinkedIn:
# Local: https://localhost:3000/api/linkedin/callback is not supported by LinkedIn.
# Use http://localhost:3000/api/linkedin/callback for local development if allowed,
# and https://your-vercel-domain.vercel.app/api/linkedin/callback for production.

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ─── App Config ──────────────────────────────────────────────────────────────
# Delay between messages in milliseconds (avoid rate limits)
WHATSAPP_SEND_DELAY_MS=1000
ANTHROPIC_API_KEY=sk-ant-...
